{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/TranslateRequest",
  "title": "TranslateRequest",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "description": "The text to translate",
      "maxLength": 10000
    },
    "target_language": {
      "type": "string",
      "default": "en",
      "description": "Target language code (default: 'en' for English)",
      "maxLength": 10
    }
  },
  "required": [
    "text"
  ]
}