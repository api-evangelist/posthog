{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/QuarantineInput",
  "title": "QuarantineInput",
  "type": "object",
  "properties": {
    "identifier": {
      "type": "string",
      "maxLength": 512
    },
    "reason": {
      "type": "string",
      "maxLength": 255
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true
    }
  },
  "required": [
    "identifier",
    "reason"
  ]
}