{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/LLMPromptOutlineEntry",
  "title": "LLMPromptOutlineEntry",
  "type": "object",
  "properties": {
    "level": {
      "type": "integer",
      "maximum": 6,
      "minimum": 1,
      "description": "Markdown heading level (1-6)."
    },
    "text": {
