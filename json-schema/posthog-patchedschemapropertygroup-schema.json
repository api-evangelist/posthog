{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PatchedSchemaPropertyGroup",
  "title": "PatchedSchemaPropertyGroup",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "name": {
      "type": "string",
      "maxLength": 400
    },
    "description": {
      "type": "string"
    },
    "properties": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/SchemaPropertyGroupProperty"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/EventDefinitionBasic"
      },
      "readOnly": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "created_by": {
      "allOf": [
        {
          "$ref": "#/components/schemas/UserBasic"
        }
      ],
      "readOnly": true
    }
  }
}