{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/InputsSchemaItem",
  "title": "InputsSchemaItem",
  "type": "object",
  "properties": {
    "type": {
      "$ref": "#/components/schemas/InputsSchemaItemTypeEnum"
    },
    "key": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "default": {},
    "secret": {
      "type": "boolean",
      "default": false
    },
    "hidden": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string"
    },
    "integration": {
      "type": "string"
    },
    "integration_key": {
      "type": "string"
    },
    "requires_field": {
      "type": "string"
    },
    "integration_field": {
      "type": "string"
    },
    "requiredScopes": {
      "type": "string"
    },
    "templating": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "hog",
            "liquid"
          ]
        }
      ]
    }
  },
  "required": [
    "key",
    "type"
  ]
}