{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PatchedEventSchema",
  "title": "PatchedEventSchema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "event_definition": {
      "type": "string",
      "format": "uuid"
    },
    "property_group": {
      "allOf": [
        {
          "$ref": "#/components/schemas/SchemaPropertyGroup"
        }
      ],
      "readOnly": true
    },
    "property_group_id": {
      "type": "string",
      "format": "uuid",
      "writeOnly": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    }
  }
}