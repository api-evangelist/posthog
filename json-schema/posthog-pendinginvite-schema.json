{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PendingInvite",
  "title": "PendingInvite",
  "type": "object",
  "description": "Shape of each item in UserSerializer.pending_invites.",
  "properties": {
    "id": {
      "type": "string"
    },
    "target_email": {
      "type": "string",
      "format": "email"
    },
    "organization_id": {
      "type": "string"
    },
    "organization_name": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "created_at",
    "id",
    "organization_id",
    "organization_name",
    "target_email"
  ]
}