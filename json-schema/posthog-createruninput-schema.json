{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/CreateRunInput",
  "title": "CreateRunInput",
  "type": "object",
  "properties": {
    "repo_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_type": {
      "type": "string"
    },
    "commit_sha": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "snapshots": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/SnapshotManifestItem"
      }
    },
    "pr_number": {
      "type": "integer",
      "nullable": true
    },
    "baseline_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "unchanged_count": {
      "type": "integer"
    },
    "removed_identifiers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "purpose": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "branch",
    "commit_sha",
    "repo_id",
    "run_type",
    "snapshots"
  ]
}