        {
          "$ref": "#/components/schemas/EventsQueryResponse"
        }
      ],
      "nullable": true
    },
    "select": {
      "description": "Return a limited set of data. Required.",
      "items": {
        "type": "string"
      },
      "title": "Select",
      "type": "array"
    },
    "source": {
      "default": null,
      "description": "source for querying events for insights",
