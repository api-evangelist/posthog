{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/NumericScoreDefinitionConfig",
  "title": "NumericScoreDefinitionConfig",
  "type": "object",
  "properties": {
    "min": {
      "type": "number",
      "format": "double",
      "nullable": true,
      "description": "Optional inclusive minimum score."
    },
    "max": {
      "type": "number",
      "format": "double",
      "nullable": true,
      "description": "Optional inclusive maximum score."
    },
    "step": {
      "type": "number",
      "format": "double",
      "nullable": true,
      "description": "Optional increment step for numeric input, for example 1 or 0.5."
    }
  }
}