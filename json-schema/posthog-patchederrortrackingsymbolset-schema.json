{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PatchedErrorTrackingSymbolSet",
  "title": "PatchedErrorTrackingSymbolSet",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "ref": {
      "type": "string"
    },
    "team_id": {
      "type": "integer",
      "readOnly": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "last_used": {
      "type": "string",
      "format": "date-time",
      "nullable": true
    },
    "storage_ptr": {
      "type": "string",
      "nullable": true
    },
    "failure_reason": {
      "type": "string",
      "nullable": true
    },
    "release": {
      "type": "object",
      "additionalProperties": true,
      "nullable": true,
      "description": "Release associated with this symbol set",
      "readOnly": true
    }
  }
}