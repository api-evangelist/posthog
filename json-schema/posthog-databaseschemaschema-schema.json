{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/DatabaseSchemaSchema",
  "title": "DatabaseSchemaSchema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "incremental": {
      "title": "Incremental",
      "type": "boolean"
    },
    "last_synced_at": {
      "default": null,
      "title": "Last Synced At",
      "type": "string",
      "nullable": true
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "should_sync": {
      "title": "Should Sync",
      "type": "boolean"
    },
    "status": {
      "default": null,
      "title": "Status",
      "type": "string",
      "nullable": true
    }
  },
  "required": [
    "id",
    "incremental",
    "name",
    "should_sync"
  ],
  "type": "object"
}