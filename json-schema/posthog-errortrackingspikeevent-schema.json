{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ErrorTrackingSpikeEvent",
  "title": "ErrorTrackingSpikeEvent",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "issue": {
      "allOf": [
        {
          "$ref": "#/components/schemas/ErrorTrackingSpikeEventIssue"
        }
      ],
      "readOnly": true
    },
    "detected_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "computed_baseline": {
      "type": "number",
      "format": "double",
      "readOnly": true
    },
    "current_bucket_value": {
      "type": "integer",
      "readOnly": true
    }
  },
  "required": [
    "computed_baseline",
    "current_bucket_value",
    "detected_at",
    "id",
    "issue"
  ]
}