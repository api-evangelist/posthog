{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/YAxisSettings",
  "title": "YAxisSettings",
  "additionalProperties": false,
  "properties": {
    "scale": {
      "default": null,
      "allOf": [
        {
          "$ref": "#/components/schemas/Scale"
        }
      ],
      "nullable": true
    },
    "showGridLines": {
      "default": null,
      "title": "Showgridlines",
      "type": "boolean",
      "nullable": true
    },
    "showTicks": {
      "default": null,
      "title": "Showticks",
      "type": "boolean",
      "nullable": true
    },
    "startAtZero": {
      "default": null,
      "description": "Whether the Y axis should start at zero",
      "title": "Startatzero",
      "type": "boolean",
      "nullable": true
    }
  },
  "type": "object"
}