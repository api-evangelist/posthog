{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PatchedHealthIssue",
  "title": "PatchedHealthIssue",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "kind": {
      "type": "string",
      "readOnly": true
    },
    "severity": {
      "allOf": [
        {
          "$ref": "#/components/schemas/HealthIssueSeverityEnum"
        }
      ],
      "readOnly": true
    },
    "status": {
      "allOf": [
        {
          "$ref": "#/components/schemas/HealthIssueStatusEnum"
        }
      ],
      "readOnly": true
    },
    "dismissed": {
      "type": "boolean"
    },
    "payload": {
      "readOnly": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true,
      "nullable": true
    }
  }
}