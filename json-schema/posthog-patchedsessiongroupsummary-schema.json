{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PatchedSessionGroupSummary",
  "title": "PatchedSessionGroupSummary",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "title": {
      "type": "string",
      "readOnly": true,
      "description": "Title of the group session summary"
    },
    "session_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "readOnly": true,
      "description": "List of session replay IDs included in this group summary"
    },
    "summary": {
      "readOnly": true,
      "description": "Group summary in JSON format (EnrichedSessionGroupSummaryPatternsList schema)"
    },
    "extra_summary_context": {
      "readOnly": true,
      "nullable": true,
      "description": "Additional context passed to the summary (ExtraSummaryContext schema)"
    },
    "run_metadata": {
      "readOnly": true,
      "nullable": true,
      "description": "Summary run metadata (SessionSummaryRunMeta schema)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "created_by": {
      "allOf": [
        {
          "$ref": "#/components/schemas/UserBasic"
        }
      ],
      "readOnly": true
    },
    "team": {
      "type": "integer",
      "readOnly": true
    }
  }
}