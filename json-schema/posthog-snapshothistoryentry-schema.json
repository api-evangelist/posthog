{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/SnapshotHistoryEntry",
  "title": "SnapshotHistoryEntry",
  "type": "object",
  "properties": {
    "current_artifact": {
      "allOf": [
        {
          "$ref": "#/components/schemas/Artifact"
        }
      ],
      "nullable": true
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "result": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "commit_sha": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "pr_number": {
      "type": "integer",
      "nullable": true
    },
    "diff_percentage": {
      "type": "number",
      "format": "double",
      "nullable": true
    },
    "review_state": {
      "type": "string"
    }
  },
  "required": [
    "branch",
    "commit_sha",
    "created_at",
    "result",
    "run_id",
    "snapshot_id"
  ]
}