{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/OrganizationIntegration",
  "title": "OrganizationIntegration",
  "type": "object",
  "description": "Serializer for organization-level integrations.",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "kind": {
      "allOf": [
        {
          "$ref": "#/components/schemas/OrganizationIntegrationKindEnum"
        }
      ],
      "readOnly": true
    },
    "integration_id": {
      "type": "string",
      "readOnly": true,
      "nullable": true
    },
    "config": {
      "readOnly": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "created_by": {
      "allOf": [
        {
          "$ref": "#/components/schemas/UserBasic"
        }
      ],
      "readOnly": true
    }
  },
  "required": [
    "config",
    "created_at",
    "created_by",
    "id",
    "integration_id",
    "kind",
    "updated_at"
