{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ActivityLog",
  "title": "ActivityLog",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "user": {
      "$ref": "#/components/schemas/UserBasic"
    },
    "unread": {
      "type": "boolean",
      "description": "is the date of this log item newer than the user's bookmark",
      "readOnly": true
    },
    "organization_id": {
      "type": "string",
      "format": "uuid",
      "nullable": true
    },
    "was_impersonated": {
      "type": "boolean",
      "nullable": true
    },
    "is_system": {
      "type": "boolean",
      "nullable": true
    },
    "client": {
      "type": "string",
      "nullable": true,
      "maxLength": 32
    },
    "activity": {
      "type": "string",
      "maxLength": 79
    },
    "item_id": {
      "type": "string",
      "nullable": true,
      "maxLength": 72
    },
    "scope": {
      "type": "string",
      "maxLength": 79
    },
    "detail": {
      "nullable": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "activity",
    "id",
    "scope",
    "unread",
    "user"
  ]
}