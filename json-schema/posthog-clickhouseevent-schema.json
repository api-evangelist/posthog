{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ClickhouseEvent",
  "title": "ClickhouseEvent",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "readOnly": true
    },
    "distinct_id": {
      "type": "string",
      "readOnly": true
    },
    "properties": {
      "type": "object",
      "additionalProperties": true,
      "readOnly": true
    },
    "event": {
      "type": "string",
      "readOnly": true
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "person": {
      "type": "object",
      "additionalProperties": true,
      "nullable": true,
      "readOnly": true
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/EventElement"
      },
      "readOnly": true
    },
    "elements_chain": {
      "type": "string",
      "readOnly": true
    }
  },
  "required": [
    "distinct_id",
    "elements",
    "elements_chain",
    "event",
    "id",
    "person",
    "properties",
    "timestamp"
  ]
}