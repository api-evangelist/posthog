{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PauseResponse",
  "title": "PauseResponse",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "description": "Always 'paused'."
    },
    "paused_until": {
      "type": "string",
      "format": "date-time",
      "description": "The timestamp the pipeline is paused until."
    }
  },
  "required": [
    "paused_until",
    "status"
  ]
}