{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/LLMPromptVersionSummary",
  "title": "LLMPromptVersionSummary",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "version": {
      "type": "integer",
      "readOnly": true
    },
    "created_by": {
      "allOf": [
        {
          "$ref": "#/components/schemas/UserBasic"
        }
      ],
      "readOnly": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "is_latest": {
      "type": "boolean",
      "readOnly": true
    }
  },
  "required": [
    "created_at",
    "created_by",
    "id",
    "is_latest",
    "version"
  ]
}