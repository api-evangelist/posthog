        {
          "$ref": "#/components/schemas/CustomEventConversionGoal"
        }
      ],
      "nullable": true
    },
    "dataColorTheme": {
      "default": null,
      "description": "Colors used in the insight's visualization - not used in Web Analytics but required for type compatibility",
      "title": "Datacolortheme",
      "type": "number",
      "nullable": true
