{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PropertyValueItem",
  "title": "PropertyValueItem",
  "additionalProperties": false,
  "properties": {
    "count": {
      "default": null,
      "title": "Count",
      "type": "integer",
      "nullable": true
    },
    "name": {
      "default": null,
      "title": "Name",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ],
      "nullable": true
    }
  },
  "type": "object"
}