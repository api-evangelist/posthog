{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Repo",
  "title": "Repo",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "team_id": {
      "type": "integer"
    },
    "repo_external_id": {
      "type": "integer"
    },
    "repo_full_name": {
      "type": "string"
    },
    "baseline_file_paths": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "enable_pr_comments": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "baseline_file_paths",
    "created_at",
    "enable_pr_comments",
    "id",
    "repo_external_id",
    "repo_full_name",
    "team_id"
  ]
}