{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PatchedApprovalPolicy",
  "title": "PatchedApprovalPolicy",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "action_key": {
      "type": "string",
      "maxLength": 128
    },
    "conditions": {},
    "approver_config": {},
    "allow_self_approve": {
      "type": "boolean"
    },
    "bypass_org_membership_levels": {},
    "bypass_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "expires_after": {
      "type": "string",
      "description": "Auto-expire change requests after this duration"
    },
    "enabled": {
      "type": "boolean"
    },
    "created_by": {
      "allOf": [
        {
          "$ref": "#/components/schemas/UserBasic"
        }
      ],
      "readOnly": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true,
      "nullable": true
    }
  }
}