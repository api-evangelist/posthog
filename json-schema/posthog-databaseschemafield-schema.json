{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/DatabaseSchemaField",
  "title": "DatabaseSchemaField",
  "additionalProperties": false,
  "properties": {
    "chain": {
      "default": null,
      "title": "Chain",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          }
        ]
      },
      "type": "array",
      "nullable": true
    },
    "fields": {
      "default": null,
      "title": "Fields",
      "items": {
        "type": "string"
      },
      "type": "array",
      "nullable": true
    },
    "hogql_value": {
      "title": "Hogql Value",
      "type": "string"
    },
    "id": {
      "default": null,
      "title": "Id",
      "type": "string",
      "nullable": true
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "schema_valid": {
      "title": "Schema Valid",
      "type": "boolean"
    },
    "table": {
      "default": null,
      "title": "Table",
      "type": "string",
      "nullable": true
    },
    "type": {
      "$ref": "#/components/schemas/DatabaseSerializedFieldType"
    }
  },
  "required": [
    "hogql_value",
    "name",
    "schema_valid",
    "type"
  ],
  "type": "object"
}