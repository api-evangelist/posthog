{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/RoleMembership",
  "title": "RoleMembership",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "role_id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "organization_member": {
      "allOf": [
        {
          "$ref": "#/components/schemas/OrganizationMember"
        }
      ],
      "readOnly": true
    },
    "user": {
      "allOf": [
        {
          "$ref": "#/components/schemas/UserBasic"
        }
      ],
      "readOnly": true
    },
    "joined_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "user_uuid": {
      "type": "string",
      "format": "uuid",
      "writeOnly": true
    }
  },
  "required": [
    "id",
    "joined_at",
    "organization_member",
    "role_id",
    "updated_at",
    "user",
    "user_uuid"
  ]
}