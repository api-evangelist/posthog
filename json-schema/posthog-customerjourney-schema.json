{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/CustomerJourney",
  "title": "CustomerJourney",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "insight": {
      "type": "integer"
    },
    "name": {
      "type": "string",
      "maxLength": 400
    },
    "description": {
      "type": "string",
      "nullable": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "created_by": {
      "type": "integer",
      "readOnly": true,
      "nullable": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true,
      "nullable": true
    }
  },
  "required": [
    "created_at",
    "created_by",
    "id",
    "insight",
    "name",
    "updated_at"
  ]
}