{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Artifact",
  "title": "Artifact",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "content_hash": {
      "type": "string"
    },
    "width": {
      "type": "integer",
      "nullable": true
    },
    "height": {
      "type": "integer",
      "nullable": true
    },
    "download_url": {
      "type": "string",
      "nullable": true
    }
  },
  "required": [
    "content_hash",
    "download_url",
    "height",
    "id",
    "width"
  ]
}