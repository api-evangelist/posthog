{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/SessionSummaries",
  "title": "SessionSummaries",
  "type": "object",
  "properties": {
    "session_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of session IDs to summarize (max 300)",
      "maxItems": 300,
      "minItems": 1
    },
    "focus_area": {
      "type": "string",
      "description": "Optional focus area for the summarization",
      "maxLength": 500
    }
  },
  "required": [
    "session_ids"
  ]
}