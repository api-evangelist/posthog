{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ModelConfiguration",
  "title": "ModelConfiguration",
  "type": "object",
  "description": "Nested serializer for model configuration.",
  "properties": {
    "provider": {
      "$ref": "#/components/schemas/LLMProviderEnum"
    },
    "model": {
      "type": "string",
      "maxLength": 100
    },
    "provider_key_id": {
      "type": "string",
      "format": "uuid",
      "nullable": true
    },
    "provider_key_name": {
      "type": "string",
      "nullable": true,
      "readOnly": true
    }
  },
  "required": [
    "model",
    "provider",
    "provider_key_name"
  ]
}