{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PaginatedBatchExportRunList",
  "title": "PaginatedBatchExportRunList",
  "type": "object",
  "required": [
    "results"
  ],
  "properties": {
    "next": {
      "type": "string",
      "nullable": true,
      "format": "uri",
      "example": "http://api.example.org/accounts/?cursor=cD00ODY%3D\""
    },
    "previous": {
      "type": "string",
      "nullable": true,
      "format": "uri",
      "example": "http://api.example.org/accounts/?cursor=cj0xJnA9NDg3"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/BatchExportRun"
      }
    }
  }
}