{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PatchedFileSystem",
  "title": "PatchedFileSystem",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "path": {
      "type": "string"
    },
    "depth": {
      "type": "integer",
      "readOnly": true,
      "nullable": true
    },
    "type": {
      "type": "string",
      "maxLength": 100
    },
    "ref": {
      "type": "string",
      "nullable": true,
      "maxLength": 100
    },
    "href": {
      "type": "string",
      "nullable": true
    },
    "meta": {
      "nullable": true
    },
    "shortcut": {
      "type": "boolean",
      "nullable": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "last_viewed_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true,
      "nullable": true
    }
  }
}