{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Credential",
  "title": "Credential",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "created_by": {
      "allOf": [
        {
          "$ref": "#/components/schemas/UserBasic"
        }
      ],
      "readOnly": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "access_key": {
      "type": "string",
      "writeOnly": true,
      "maxLength": 500
    },
    "access_secret": {
      "type": "string",
      "writeOnly": true,
      "maxLength": 500
    }
  },
  "required": [
    "access_key",
    "access_secret",
    "created_at",
    "created_by",
    "id"
  ]
}