{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/SharingConfiguration",
  "title": "SharingConfiguration",
  "type": "object",
  "properties": {
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "enabled": {
      "type": "boolean"
    },
    "access_token": {
      "type": "string",
      "readOnly": true,
      "nullable": true
    },
    "settings": {
      "nullable": true
    },
    "password_required": {
      "type": "boolean"
    },
    "share_passwords": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/SharePassword"
      },
      "readOnly": true
    }
  },
  "required": [
    "access_token",
    "created_at",
    "share_passwords"
  ]
}