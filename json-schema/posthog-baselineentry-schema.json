{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/BaselineEntry",
  "title": "BaselineEntry",
  "type": "object",
  "properties": {
    "sparkline": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/BaselineSparklineDay"
      }
    },
    "identifier": {
      "type": "string"
    },
    "run_type": {
      "type": "string"
    },
    "browser": {
      "type": "string",
      "nullable": true
    },
    "thumbnail_hash": {
      "type": "string",
      "nullable": true
    },
    "width": {
      "type": "integer",
      "nullable": true
    },
    "height": {
      "type": "integer",
      "nullable": true
    },
    "tolerate_count_30d": {
      "type": "integer"
    },
    "tolerate_count_90d": {
      "type": "integer"
    },
    "is_quarantined": {
      "type": "boolean"
    },
    "last_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "recent_diff_avg": {
      "type": "number",
      "format": "double",
      "nullable": true
    }
  },
  "required": [
    "browser",
    "height",
    "identifier",
    "is_quarantined",
    "last_run_at",
    "recent_diff_avg",
    "run_type",
    "sparkline",
    "thumbnail_hash",
    "tolerate_count_30d",
    "tolerate_count_90d",
    "width"
  ]
}