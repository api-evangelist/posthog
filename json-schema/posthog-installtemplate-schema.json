{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/InstallTemplate",
  "title": "InstallTemplate",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string",
      "format": "uuid"
    },
    "api_key": {
      "type": "string",
      "default": ""
    },
    "install_source": {
      "allOf": [
        {
          "$ref": "#/components/schemas/InstallSourceEnum"
        }
      ],
      "default": "posthog"
    },
    "posthog_code_callback_url": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "template_id"
  ]
}