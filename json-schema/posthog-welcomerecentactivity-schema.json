{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/_WelcomeRecentActivity",
  "title": "_WelcomeRecentActivity",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "description": "Scope.activity pair, e.g. 'Insight.created'."
    },
    "actor_name": {
      "type": "string"
    },
    "entity_name": {
      "type": "string"
    },
    "entity_url": {
      "type": "string",
      "nullable": true
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "actor_name",
    "entity_name",
    "entity_url",
    "timestamp",
    "type"
  ]
}