{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/SchemaPropertyGroupProperty",
  "title": "SchemaPropertyGroupProperty",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "name": {
      "type": "string",
      "maxLength": 400
    },
    "property_type": {
      "$ref": "#/components/schemas/SchemaPropertyGroupPropertyPropertyTypeEnum"
    },
    "is_required": {
      "type": "boolean"
    },
    "is_optional_in_types": {
      "type": "boolean"
    },
    "description": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    }
  },
  "required": [
    "created_at",
    "id",
    "name",
    "property_type",
    "updated_at"
  ]
