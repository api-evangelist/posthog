{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Person",
  "title": "Person",
  "additionalProperties": false,
  "properties": {
    "distinct_ids": {
      "items": {
        "type": "string"
      },
      "title": "Distinct Ids",
      "type": "array"
    },
    "is_identified": {
      "default": null,
      "title": "Is Identified",
      "type": "boolean",
      "nullable": true
    },
    "properties": {
      "type": "object",
      "additionalProperties": true,
      "title": "Properties"
    }
  },
  "required": [
    "distinct_ids",
    "properties"
  ],
  "type": "object"
}