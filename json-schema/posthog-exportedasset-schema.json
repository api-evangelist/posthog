{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ExportedAsset",
  "title": "ExportedAsset",
  "type": "object",
  "description": "Standard ExportedAsset serializer that doesn't return content.",
  "properties": {
    "id": {
      "type": "integer",
      "readOnly": true
    },
    "dashboard": {
      "type": "integer",
      "nullable": true
    },
    "insight": {
      "type": "integer",
      "nullable": true
    },
    "export_format": {
      "$ref": "#/components/schemas/ExportFormatEnum"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "has_content": {
      "type": "boolean",
      "readOnly": true
    },
    "export_context": {
      "nullable": true
    },
    "filename": {
      "type": "string",
      "readOnly": true
    },
    "expires_after": {
      "type": "string",
      "format": "date-time",
      "readOnly": true,
      "nullable": true
    },
    "exception": {
      "type": "string",
      "readOnly": true,
      "nullable": true
    }
  },
  "required": [
    "created_at",
    "exception",
    "expires_after",
    "export_format",
    "filename",
    "has_content",
    "id"
  ]
}