{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ErrorTrackingStackFrame",
  "title": "ErrorTrackingStackFrame",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "raw_id": {
      "type": "string",
      "description": "Raw frame ID in 'hash/part' format",
      "readOnly": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "contents": {},
    "resolved": {
      "type": "boolean"
    },
    "context": {
      "nullable": true
    },
    "symbol_set_ref": {
      "type": "string"
    },
    "release": {
      "allOf": [
        {
          "$ref": "#/components/schemas/ErrorTrackingRelease"
        }
      ],
      "readOnly": true
    }
  },
  "required": [
    "contents",
    "created_at",
    "id",
    "raw_id",
    "release",
    "resolved"
  ]
}