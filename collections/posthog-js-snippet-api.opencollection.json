                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "Project ID of the project you're trying to access. To find the ID of the project, make a call to /api/projects/."
              }
            ]
          },
          "docs": "Return the team's current version pin and resolved version."
        },
        {
          "info": {
            "name": "js_snippet_version_partial_update",
            "type": "http"
          },
