            "url": "{{baseUrl}}/api/projects/:project_id/js-snippet/resolve/",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "Project ID of the project you're trying to access. To find the ID of the project, make a call to /api/projects/."
              }
            ]
          },
          "docs": "Preview what a given pin would resolve to, without saving it."
        },
        {
          "info": {
            "name": "js_snippet_version_retrieve",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects/:project_id/js-snippet/version/",
            "params": [
