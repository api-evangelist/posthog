{
  "opencollection": "1.0.0",
  "info": {
    "name": "PostHog actions plugin_configs API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "plugin_configs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "environments_plugin_configs_logs_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/environments/:environment_id/plugin_configs/:plugin_config_id/logs/",
            "params": [
              {
                "name": "environment_id",
                "value": "",
                "type": "path",
                "description": "Deprecated. Use /api/projects/{project_id}/ instead."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The initial index from which to return the results."
              },
              {
                "name": "plugin_config_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        },
        {
          "info": {
            "name": "plugin_configs_logs_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects/:project_id/plugin_configs/:plugin_config_id/logs/",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The initial index from which to return the results."
              },
              {
                "name": "plugin_config_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "Project ID of the project you're trying to access. To find the ID of the project, make a call to /api/projects/."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}